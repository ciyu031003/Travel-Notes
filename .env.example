DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/Travel_And_Study"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# JWT 密钥（用于 Token 签名与验证，用 openssl rand -hex 32 生成）
# 生产环境必须配置，缺失将拒绝启动（安全策略）
JWT_SECRET="change-this-to-a-random-secret-key"

# 备用密钥（兼容旧配置，优先使用 JWT_SECRET）
SESSION_SECRET="change-this-to-a-random-secret-key"

COOKIE_SECURE=false


# ===== 对象存储（可选，配置后自动启用 S3 兼容存储；不配置则使用本地 public/uploads）=====
# STORAGE_ENDPOINT="https://your-minio.example.com"
# STORAGE_ACCESS_KEY="minio-admin"
# STORAGE_SECRET_KEY="change-me"
# STORAGE_BUCKET="travel-notes"
# STORAGE_REGION="auto"
# STORAGE_PUBLIC_BASE_URL="https://cdn.example.com/travel-notes"

# 邮件服务：设为 true 后验证码走真实邮件发送（需自行接入邮件服务实现）
# 保持 false 时验证码仅写入服务端日志，不向前端回显（本地调试用）
EMAIL_ENABLED=false

# 站点信息（用于 RSS feed）
NEXT_PUBLIC_SITE_TITLE="Travel-Notes"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# Giscus 评论（可选，未配置则不显示评论；需在 GitHub 仓库启用 Discussions 并安装 giscus app）
# 参考: https://giscus.app/zh-CN
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY="Announcements"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""
NEXT_PUBLIC_GISCUS_MAPPING="pathname"
NEXT_PUBLIC_GISCUS_THEME="preferred_color_scheme"
