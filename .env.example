DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/Travel_And_Study"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# JWT 密钥（用于 Token 签名与验证，用 openssl rand -hex 32 生成）
# 生产环境必须配置，缺失将拒绝启动（安全策略）
JWT_SECRET="change-this-to-a-random-secret-key"

# 备用密钥（兼容旧配置，优先使用 JWT_SECRET）
SESSION_SECRET="change-this-to-a-random-secret-key"

COOKIE_SECURE=false

# 注册开关（P0-6）：设为 false 时 POST /api/register 返回 403（注册暂未开放）。
# 公开注册是账号接管链的前置条件之一，P0 期间如需止血可先关闭；默认开启。
REGISTRATION_ENABLED=true

# 移动端本地壳跨域访问 API 的额外允许主机名（逗号分隔；localhost/127.0.0.1 恒放行）。
# 不配置时默认放行历史域名 travel-notes.yuanabd.cn 与服务器 IP 106.55.2.197
# CORS_ALLOWED_HOSTNAMES="travel-notes.yuanabd.cn,106.55.2.197"


# ===== 对象存储（可选，配置后自动启用 S3 兼容存储；不配置则使用本地 public/uploads）=====
# STORAGE_ENDPOINT="https://your-minio.example.com"
# STORAGE_ACCESS_KEY="minio-admin"
# STORAGE_SECRET_KEY="change-me"
# STORAGE_BUCKET="travel-notes"
# STORAGE_REGION="auto"
# STORAGE_PUBLIC_BASE_URL="https://cdn.example.com/travel-notes"

# ===== APK 发布到腾讯云 COS + CDN（scripts/publish-apk.cjs）=====
# COS_ENDPOINT="https://cos.ap-guangzhou.myqcloud.com"
# COS_REGION="ap-guangzhou"
# COS_BUCKET="travel-notes-1300000000"
# COS_ACCESS_KEY_ID=""
# COS_SECRET_ACCESS_KEY=""
# COS_OBJECT_KEY="downloads/tiantu-1.5.0.apk"  # 可选；留空时按 package.json 版本自动生成
# 固定路径（downloads/tiantu.apk）会触发 CDN 一年长缓存，发新版时建议换版本化 key 或刷新 CDN
# COS_CDN_BASE_URL="https://dl.yuanabd.cn"
# APP_DOWNLOAD_URL="https://dl.yuanabd.cn/downloads/tiantu-1.5.0.apk"

# 邮件服务：设为 true 后验证码走真实邮件发送（需自行接入邮件服务实现）
# 保持 false 时验证码仅写入服务端日志，不向前端回显（本地调试用）
EMAIL_ENABLED=false

# 站点信息（用于 RSS feed）
NEXT_PUBLIC_SITE_TITLE="甜途"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# Giscus 评论（可选，未配置则不显示评论；需在 GitHub 仓库启用 Discussions 并安装 giscus app）
# 参考: https://giscus.app/zh-CN
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY="Announcements"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""
NEXT_PUBLIC_GISCUS_MAPPING="pathname"
NEXT_PUBLIC_GISCUS_THEME="preferred_color_scheme"

# ===== 邮件发送（SMTP，用于密码找回/绑定邮箱验证码）=====
# 配置后自动启用真实邮件发送；不配置则验证码仅输出到服务端日志（本地调试）
# 常见配置示例：
#   QQ 邮箱:    SMTP_HOST=smtp.qq.com   SMTP_PORT=465 SMTP_SECURE=true
#   Gmail:      SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true（需应用专用密码）
#   阿里企业邮: SMTP_HOST=smtp.qiye.aliyun.com SMTP_PORT=465 SMTP_SECURE=true
#   自定义:     SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_SECURE=false
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
MAIL_FROM=""

# ===== Docker 部署 =====
APP_PORT="3000"
MYSQL_ROOT_PASSWORD="change-me-strong-password"

# ===== 多副本准备（可选；不配置 = 单实例纯内存行为，与改造前完全一致）=====
# Redis：多副本共享限流/缓存（docker compose --profile redis up -d 后填 redis://127.0.0.1:6379）
# 未配置时每个副本各自内存计数/缓存；连接失败/超时 500ms 自动降级内存并只告警一次。
# REDIS_URL="redis://127.0.0.1:6379"

# 媒体分片/转码临时目录根（默认系统临时目录）。多副本时填**所有副本都可见**的共享卷路径，
# 否则「init 在副本 A、chunk 落到副本 B」会找不到会话目录。
# MEDIA_TMP_DIR="/data/travel-notes/media-tmp"

# 可选 Redis 服务端口（docker-compose 的 redis profile 只绑回环；默认 6379）
# REDIS_PORT="6379"
