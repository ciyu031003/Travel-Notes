generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @db.VarChar(255)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  date      DateTime @db.Timestamp(3)
  cover     String?  @db.VarChar(500)
  images    String?  @db.Text
  videos    String?  @db.Text
  tags      String?  @db.Text
  location  String?  @db.VarChar(255)
  type      String   @default("travel") @db.VarChar(50)
  summary   String?  @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  postImages PostImage[]

  @@unique([type, slug])
  @@index([type, published, date])
  @@index([published, date])
  @@index([location])
  @@index([createdAt])
}

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int
  data      Bytes    @db.LongBlob
  mimeType  String   @db.VarChar(100)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}

model Danmaku {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(255)
  color     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([createdAt])
}

model SiteSetting {
  id                    Int       @id @default(autoincrement())
  username              String    @unique @db.VarChar(255)
  passwordHash          String    @db.Text
  email                 String?   @db.VarChar(255)
  emailVerified         Boolean   @default(false)
  resetToken            String?   @db.VarChar(255)
  resetTokenExp         DateTime? @db.Timestamp(3)
  requirePasswordChange Boolean   @default(false)
  anniversaryStart      String?   @db.VarChar(50)
  createdAt             DateTime  @default(now()) @db.Timestamp(3)
  updatedAt             DateTime  @updatedAt @db.Timestamp(3)

  @@index([resetToken])
}

/// 用户账号（多账号基础：当前为单管理员迁移自 SiteSetting，未来支持情侣双账号）
model User {
  id                    Int      @id @default(autoincrement())
  username              String   @unique @db.VarChar(255)
  passwordHash          String   @db.Text
  email                 String?  @db.VarChar(255)
  emailVerified         Boolean  @default(false)
  requirePasswordChange Boolean  @default(false)
  anniversaryStart      String?  @db.VarChar(50)
  createdAt             DateTime @default(now()) @db.Timestamp(3)
  updatedAt             DateTime @updatedAt @db.Timestamp(3)

  sessions     Session[]
  spaceMembers SpaceMember[]
  memories     Memory[]      @relation("MemoryCreatedBy")
  auditLogs    AuditLog[]

  @@index([email])
}

model Repo {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(200)
  description String?  @db.Text
  language    String?  @db.VarChar(50)
  stars       Int      @default(0)
  cover       String?  @db.VarChar(500)
  tags        String?  @db.Text
  repoPath    String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  @@index([name])
}

model TokenBlacklist {
  jti       String   @id @db.VarChar(64)
  expiresAt DateTime @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([expiresAt])
}

/// 邮箱验证码（密码重置 / 绑定邮箱），只保存哈希
model VerificationCode {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(255)
  purpose    String    @db.VarChar(50)
  codeHash   String    @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamp(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamp(3)
  ipHash     String?   @db.VarChar(128)
  createdAt  DateTime  @default(now()) @db.Timestamp(3)

  @@index([email, purpose, createdAt])
  @@index([purpose, createdAt])
}

model Moment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  tags      String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@index([createdAt])
}

model Like {
  id         Int      @id @default(autoincrement())
  targetType String   @db.VarChar(50)
  targetId   String   @db.VarChar(255)
  visitorId  String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  @@unique([targetType, targetId, visitorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model PhotoMessage {
  id        Int      @id @default(autoincrement())
  imageKey  String   @db.VarChar(500)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([imageKey, createdAt])
}

// ============================================================
// Phase 0 (P0): Database-backed Session
// ============================================================
model Session {
  id         String    @id @db.VarChar(64)
  username   String    @db.VarChar(255)
  userId     Int?
  expiresAt  DateTime  @db.Timestamp(3)
  createdAt  DateTime  @default(now()) @db.Timestamp(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamp(3)
  userAgent  String?   @db.VarChar(500)
  ipHash     String?   @db.VarChar(128)
  revokedAt  DateTime? @db.Timestamp(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// Phase 1 (P1): Space / Memory data models
// ============================================================
enum SpaceRole {
  OWNER
  MEMBER
  VIEWER
}

enum SpaceMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum TravelStatus {
  PLANNED
  ONGOING
  COMPLETED
}

enum Visibility {
  PRIVATE
  COUPLE
  PUBLIC
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaVariantType {
  ORIGINAL
  THUMBNAIL
  PREVIEW
  BLUR
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  UPLOAD_MEDIA
  DELETE_MEDIA
  INVITE_MEMBER
  UPDATE_PERMISSIONS
  CHANGE_PASSWORD
  SETTINGS_UPDATE
}

/// 情侣共同生活的数字空间（核心业务模型）
model Space {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  slug         String   @unique @db.VarChar(200)
  description  String?  @db.Text
  coverMediaId Int?     @unique
  coverMedia   Media?   @relation("SpaceCover", fields: [coverMediaId], references: [id])
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)

  members       SpaceMember[]
  invites       SpaceInvite[]
  travels       Travel[]
  memories      Memory[]
  albums        Album[]
  media         Media[]        @relation("MediaSpace")
  auditLogs     AuditLog[]
  timelineItems TimelineItem[]

  @@index([slug])
}

/// 空间成员（角色：OWNER/MEMBER/VIEWER）
model SpaceMember {
  id       Int               @id @default(autoincrement())
  spaceId  Int
  username String            @db.VarChar(255)
  userId   Int?
  role     SpaceRole         @default(MEMBER)
  status   SpaceMemberStatus @default(ACTIVE)
  joinedAt DateTime          @default(now()) @db.Timestamp(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([spaceId, username])
  @@index([spaceId, role])
}

/// 空间邀请（只保存 Token Hash，不保存明文 Token）
model SpaceInvite {
  id        Int       @id @default(autoincrement())
  spaceId   Int
  tokenHash String    @unique @db.VarChar(128)
  role      SpaceRole @default(MEMBER)
  expiresAt DateTime  @db.Timestamp(3)
  createdBy String    @db.VarChar(255)
  usedAt    DateTime? @db.Timestamp(3)
  createdAt DateTime  @default(now()) @db.Timestamp(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

/// 旅行
model Travel {
  id           Int          @id @default(autoincrement())
  spaceId      Int?
  title        String       @db.VarChar(255)
  slug         String       @db.VarChar(255)
  description  String?      @db.Text
  content      String?      @db.Text
  tags         String?      @db.Text
  location     String?      @db.VarChar(255)
  cover        String?      @db.VarChar(500)
  startDate    DateTime?    @db.Timestamp(3)
  endDate      DateTime?    @db.Timestamp(3)
  coverMediaId Int?
  coverMedia   Media?       @relation("TravelCover", fields: [coverMediaId], references: [id])
  status       TravelStatus @default(PLANNED)
  visibility   Visibility   @default(COUPLE)
  createdAt    DateTime     @default(now()) @db.Timestamp(3)
  updatedAt    DateTime     @updatedAt @db.Timestamp(3)

  space    Space?      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  days     TravelDay[]
  memories Memory[]
  expenses Expense[]

  @@unique([spaceId, slug])
  @@index([spaceId, startDate])
}

/// 旅行中的一天
model TravelDay {
  id        Int       @id @default(autoincrement())
  travelId  Int
  date      DateTime? @db.Timestamp(3)
  title     String?   @db.VarChar(255)
  summary   String?   @db.Text
  sortOrder Int       @default(0)

  travel         Travel          @relation(fields: [travelId], references: [id], onDelete: Cascade)
  memories       Memory[]
  itineraryItems ItineraryItem[]

  @@index([travelId, sortOrder])
}

/// 地点（为地图/搜索/时间线/回忆提供统一基础）
model Location {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  address    String?  @db.VarChar(500)
  country    String?  @db.VarChar(100)
  city       String?  @db.VarChar(100)
  latitude   Float?
  longitude  Float?
  externalId String?  @db.VarChar(255)
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  updatedAt  DateTime @updatedAt @db.Timestamp(3)

  memories       Memory[]
  itineraryItems ItineraryItem[]

  @@index([city])
  @@index([name])
}

/// 回忆（产品核心实体）
model Memory {
  id          Int        @id @default(autoincrement())
  spaceId     Int
  travelId    Int?
  travelDayId Int?
  title       String     @db.VarChar(255)
  content     String?    @db.Text
  happenedAt  DateTime?  @db.Timestamp(3)
  locationId  Int?
  mood        String?    @db.VarChar(50)
  visibility  Visibility @default(COUPLE)
  createdBy   String     @db.VarChar(255)
  createdById Int?
  createdAt   DateTime   @default(now()) @db.Timestamp(3)
  updatedAt   DateTime   @updatedAt @db.Timestamp(3)

  space         Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  travel        Travel?    @relation(fields: [travelId], references: [id], onDelete: SetNull)
  travelDay     TravelDay? @relation(fields: [travelDayId], references: [id], onDelete: SetNull)
  location      Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  media         Media[]
  createdByUser User?      @relation("MemoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([spaceId, happenedAt])
  @@index([spaceId, travelId])
}

/// 独立媒体（从 Post 中彻底独立）
model Media {
  id         Int        @id @default(autoincrement())
  spaceId    Int?
  memoryId   Int?
  type       MediaType
  storageKey String     @db.VarChar(500)
  mimeType   String     @db.VarChar(100)
  size       Int        @default(0)
  width      Int?
  height     Int?
  duration   Int?
  hash       String?    @db.VarChar(128)
  takenAt    DateTime?  @db.Timestamp(3)
  latitude   Float?
  longitude  Float?
  visibility Visibility @default(COUPLE)
  createdAt  DateTime   @default(now()) @db.Timestamp(3)

  spaceOwner         Space?         @relation("MediaSpace", fields: [spaceId], references: [id])
  spaceCoverOf       Space?         @relation("SpaceCover")
  anniversaryCoverOf Anniversary?   @relation("AnniversaryCover")
  albumCoverOf       Album?         @relation("AlbumCover")
  memory             Memory?        @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  travels            Travel[]       @relation("TravelCover")
  variants           MediaVariant[]
  albums             AlbumMedia[]

  @@index([spaceId, type])
  @@index([memoryId])
}

/// 媒体变体（Original/Thumbnail/Preview/Blur）
model MediaVariant {
  id         Int              @id @default(autoincrement())
  mediaId    Int
  variant    MediaVariantType
  storageKey String           @db.VarChar(500)
  width      Int?
  height     Int?
  size       Int              @default(0)
  mimeType   String           @db.VarChar(100)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, variant])
}

/// 相册
model Album {
  id           Int        @id @default(autoincrement())
  spaceId      Int?
  title        String     @db.VarChar(255)
  description  String?    @db.Text
  coverMediaId Int?       @unique
  coverMedia   Media?     @relation("AlbumCover", fields: [coverMediaId], references: [id])
  date         DateTime?  @db.Timestamp(3)
  locationId   Int?
  visibility   Visibility @default(COUPLE)
  createdAt    DateTime   @default(now()) @db.Timestamp(3)
  updatedAt    DateTime   @updatedAt @db.Timestamp(3)

  space Space?       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items AlbumMedia[]

  @@index([spaceId, createdAt])
}

/// 相册-媒体关联
model AlbumMedia {
  id        Int @id @default(autoincrement())
  albumId   Int
  mediaId   Int
  sortOrder Int @default(0)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([albumId, mediaId])
}

/// 审计日志
model AuditLog {
  id           Int         @id @default(autoincrement())
  spaceId      Int?
  username     String      @db.VarChar(255)
  userId       Int?
  action       AuditAction
  resourceType String?     @db.VarChar(100)
  resourceId   String?     @db.VarChar(255)
  metadata     String?     @db.Text
  ipHash       String?     @db.VarChar(128)
  createdAt    DateTime    @default(now()) @db.Timestamp(3)

  space Space? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
  @@index([username, createdAt])
  @@index([action])
}

/// 纪念日（第一次见面/第一次旅行/生日等）
model Anniversary {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  date         DateTime @db.Timestamp(3)
  recurring    Boolean  @default(true)
  description  String?  @db.Text
  coverMediaId Int?     @unique
  coverMedia   Media?   @relation("AnniversaryCover", fields: [coverMediaId], references: [id])
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)

  @@index([date])
}

/// 统一时间线条目（旅行/回忆/日记/照片/相册/纪念日）
model TimelineItem {
  id          Int      @id @default(autoincrement())
  spaceId     Int?
  type        String   @db.VarChar(50)
  sourceId    Int?
  title       String   @db.VarChar(255)
  description String?  @db.Text
  happenedAt  DateTime @db.Timestamp(3)
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, happenedAt])
  @@index([type, happenedAt])
}

/// 行程项（属于某天的某个行程）
model ItineraryItem {
  id          Int       @id @default(autoincrement())
  travelDayId Int
  startTime   DateTime? @db.Timestamp(3)
  endTime     DateTime? @db.Timestamp(3)
  title       String    @db.VarChar(255)
  locationId  Int?
  type        String    @default("SPOT") @db.VarChar(50)
  notes       String?   @db.Text
  sortOrder   Int       @default(0)

  travelDay TravelDay? @relation(fields: [travelDayId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([travelDayId, sortOrder])
}

/// 旅行花费（支持分类与分摊记录）
model Expense {
  id         Int       @id @default(autoincrement())
  travelId   Int
  amount     Float
  currency   String    @default("CNY") @db.VarChar(10)
  category   String    @db.VarChar(50)
  payer      String?   @db.VarChar(255)
  note       String?   @db.Text
  happenedAt DateTime? @db.Timestamp(3)
  createdAt  DateTime  @default(now()) @db.Timestamp(3)

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([travelId])
}
