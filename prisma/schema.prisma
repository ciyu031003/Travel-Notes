generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @db.VarChar(255)
  title      String   @db.VarChar(255)
  content   String   @db.Text
  date      DateTime @db.Timestamp(3)
  cover     String?  @db.VarChar(500)
  images    String?  @db.Text
  videos    String?  @db.Text
  tags      String?  @db.Text
  location  String?  @db.VarChar(255)
  type      String   @default("travel") @db.VarChar(50)
  summary   String?  @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  postImages PostImage[]

  @@unique([type, slug])
  @@index([type, published, date])
  @@index([published, date])
  @@index([location])
  @@index([createdAt])
}

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int
  data      Bytes   @db.LongBlob
  mimeType  String   @db.VarChar(100)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}

model Danmaku {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(255)
  color     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([createdAt])
}

model SiteSetting {
  id                    Int      @id @default(autoincrement())
  username              String   @unique @db.VarChar(255)
  passwordHash          String   @db.Text
  email                 String?  @db.VarChar(255)
  emailVerified         Boolean  @default(false)
  resetToken            String?  @db.VarChar(255)
  resetTokenExp         DateTime? @db.Timestamp(3)
  requirePasswordChange Boolean  @default(false)
  anniversaryStart      String?  @db.VarChar(50)
  createdAt             DateTime @default(now()) @db.Timestamp(3)
  updatedAt             DateTime @updatedAt @db.Timestamp(3)

  @@index([resetToken])
}

model Repo {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(200)
  description String?  @db.Text
  language    String?  @db.VarChar(50)
  stars       Int      @default(0)
  cover       String?  @db.VarChar(500)
  tags        String?  @db.Text
  repoPath    String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  @@index([name])
}

model TokenBlacklist {
  jti       String   @id @db.VarChar(64)
  expiresAt DateTime @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([expiresAt])
}

model Moment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  tags      String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  @@index([createdAt])
}

model Like {
  id         Int      @id @default(autoincrement())
  targetType String   @db.VarChar(50)
  targetId   String   @db.VarChar(255)
  visitorId  String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  @@unique([targetType, targetId, visitorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
