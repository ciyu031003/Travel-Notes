<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      C1 移动端安全加固：
      · usesCleartextTraffic=false + networkSecurityConfig：API 与媒体一律 HTTPS，
        杜绝运营商/中间人把 http 明文注入 WebView（配合 capacitor allowMixedContent=false）；
      · allowBackup=false + fullBackupContent=false + dataExtractionRules：
        SQLite（含加密库密钥不可备份但明文库曾被备份）与 WebView Cookie 不再进
        adb backup / 云备份 / 换机迁移，物理接触者无法用备份把本地数据整体取出。
    -->
    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          移动互联网应用程序备案号（工信部 App 备案 · 赣ICP备2024031528号-4A）。
          写入安装包元数据，供应用市场 / 备案核验工具在扫描 APK 时读取；
          App 内的可见展示见 www/（登录页、首页、账号设置 → 关于、下载页）。
        -->
        <meta-data
            android:name="icp_license"
            android:value="@string/icp_license" />
        <meta-data
            android:name="icp_license_query_url"
            android:value="@string/icp_license_query_url" />
        <!-- 网站备案号（yuanabd.cn 主站及子域名）、工信部备案号、公安联网备案号 -->
        <meta-data
            android:name="site_icp_license"
            android:value="@string/site_icp_license" />
        <meta-data
            android:name="miit_filing_no"
            android:value="@string/miit_filing_no" />
        <meta-data
            android:name="police_filing_no"
            android:value="@string/police_filing_no" />
        <meta-data
            android:name="police_filing_query_url"
            android:value="@string/police_filing_query_url" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：下载 APK 后直接拉起系统安装器（Android 8+ 还需用户在系统设置里为本应用授权「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
